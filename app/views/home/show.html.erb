<% identity = Rails.configuration.x.foundation %>
<% title "Beacon — ship your SaaS faster" %>

<section class="md-hero" aria-labelledby="hero-title">
  <div class="md-hero__inner">
    <div>
      <p class="md-section__eyebrow">Beacon</p>
      <h1 id="hero-title">Every signal your team needs to ship.</h1>
      <p>Beacon brings analytics, alerts, and a shared product pulse into one place — so you notice what matters before it becomes an incident.</p>
      <div class="md-actions">
        <%= link_to "Start free", "#signup", class: "md-button md-button--filled" %>
        <%= link_to "See pricing", "#pricing", class: "md-button md-button--outlined" %>
      </div>
    </div>
    <div class="md-hero__art" aria-hidden="true"><div class="md-hero__orb"></div></div>
  </div>
</section>

<section class="md-section" aria-labelledby="features-title" id="features">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Features</p>
    <h2 id="features-title" class="md-section__heading">One dashboard for the signals that matter.</h2>
    <div class="md-grid">
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:task_alt, size: 32) %></span>
        <div>
          <h3>Live product pulse</h3>
          <p>Key metrics — activations, errors, latency — updated in real time, so the whole team reads the same story.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:notifications, size: 32) %></span>
        <div>
          <h3>Smart alerts</h3>
          <p>Thresholds, anomalies, and quiet hours tuned per channel. Beacon tells you when something's off — and when it isn't worth a page.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:workspaces, size: 32) %></span>
        <div>
          <h3>Shared pulse</h3>
          <p>Every teammate sees the same signals, comments in context, and links an alert straight to the fix.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:settings, size: 32) %></span>
        <div>
          <h3>Minutes to setup</h3>
          <p>Drop in a snippet or a webhook, and the first signals appear before your coffee cools.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:check_circle, size: 32) %></span>
        <div>
          <h3>Secure by default</h3>
          <p>SSO, audit logs, and granular roles. Your data stays yours, encrypted in transit and at rest.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:search, size: 32) %></span>
        <div>
          <h3>History that helps</h3>
          <p>Every alert keeps its full timeline, so a week later you can answer why — not just what happened.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="md-section md-section--alt" aria-labelledby="pricing-title" id="pricing">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Pricing</p>
    <h2 id="pricing-title" class="md-section__heading">Start free. Scale when you're ready.</h2>
    <div class="md-pricing-grid">
      <article class="md-card md-card--outlined md-price-card">
        <h3>Starter</h3>
        <p class="text-md-on-surface-variant">For side projects finding their footing.</p>
        <p class="md-price-card__price">$0<span class="text-md-on-surface-variant">/mo</span></p>
        <ul>
          <li>Up to 3 teammates</li>
          <li>10k events / month</li>
          <li>1 alert channel</li>
          <li>7-day history</li>
        </ul>
        <%= link_to "Start free", "#signup", class: "md-button md-button--outlined" %>
      </article>
      <article class="md-card md-card--elevated md-price-card">
        <span class="md-chip selected">Most popular</span>
        <h3>Pro</h3>
        <p class="text-md-on-surface-variant">For teams shipping every week.</p>
        <p class="md-price-card__price">$49<span class="text-md-on-surface-variant">/mo</span></p>
        <ul>
          <li>Unlimited teammates</li>
          <li>1M events / month</li>
          <li>Unlimited channels</li>
          <li>90-day history</li>
          <li>Anomaly detection</li>
        </ul>
        <%= link_to "Start free trial", "#signup", class: "md-button md-button--filled" %>
      </article>
      <article class="md-card md-card--outlined md-price-card">
        <h3>Enterprise</h3>
        <p class="text-md-on-surface-variant">For orgs with compliance needs.</p>
        <p class="md-price-card__price">Custom</p>
        <ul>
          <li>Everything in Pro</li>
          <li>SSO / SAML</li>
          <li>Audit logs</li>
          <li>Dedicated support</li>
        </ul>
        <%= link_to "Talk to sales", "#signup", class: "md-button md-button--outlined" %>
      </article>
    </div>
  </div>
</section>

<section class="md-section" aria-labelledby="faq-title" id="faq">
  <div class="md-section__inner md-section__inner--narrow">
    <p class="md-section__eyebrow">FAQ</p>
    <h2 id="faq-title" class="md-section__heading">Questions, answered.</h2>
    <div class="md-faq">
      <details class="md-faq__item">
        <summary>How long does setup take?</summary>
        <p>Most teams see their first signal within ten minutes. Add a webhook or a small snippet, pick your channels, and you're live.</p>
      </details>
      <details class="md-faq__item">
        <summary>Can I try Pro before paying?</summary>
        <p>Yes — every new workspace gets a 14-day Pro trial, no card required.</p>
      </details>
      <details class="md-faq__item">
        <summary>What happens if I go over my event limit?</summary>
        <p>We never drop your data. You'll get a heads-up as you approach the limit, and overage is capped so a bad day can't become a surprise bill.</p>
      </details>
      <details class="md-faq__item">
        <summary>Do you support SSO?</summary>
        <p>SSO and SAML are available on the Enterprise plan, alongside audit logs and dedicated support.</p>
      </details>
      <details class="md-faq__item">
        <summary>Can I cancel anytime?</summary>
        <p>Anytime, from your billing page. No calls, no retention flow — your data stays exportable for 30 days.</p>
      </details>
    </div>
  </div>
</section>

<section class="md-section md-section--alt" aria-labelledby="signup-title" id="signup">
  <div class="md-section__inner md-section__inner--narrow">
    <p class="md-section__eyebrow">Get started</p>
    <h2 id="signup-title" class="md-section__heading">Be first to know when Beacon launches.</h2>
    <p class="text-center text-md-on-surface-variant">Join the list — we'll send a short note when it's your turn, and nothing else.</p>

    <div class="md-card md-card--outlined md-signup-card">
      <%= form_with model: @lead, url: leads_path, id: "lead-form", class: "md-form" do |form| %>
        <% if @lead.errors.any? %>
          <div class="md-form__errors" role="alert">
            <p><%= pluralize(@lead.errors.count, "problem") %> with your signup:</p>
            <ul>
              <% @lead.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= render "foundation/components/text_field", form: form, attribute: :name, label: "Name", type: :text, hint: nil, options: { placeholder: "Ada Lovelace", autocomplete: "name" } %>
        <%= render "foundation/components/text_field", form: form, attribute: :email, label: "Work email", type: :email, hint: nil, options: { placeholder: "ada@company.com", autocomplete: "email", required: true } %>

        <div class="md-actions">
          <%= render "foundation/components/button", form: form, label: "Get early access", variant: "filled", type: "submit" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
